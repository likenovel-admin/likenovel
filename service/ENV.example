# =========================================================
# likenovel-user (Next.js) - 환경변수 예시
# ---------------------------------------------------------
# 사용법:
# - 개발: 이 내용을 참고해서 `.env` 파일을 직접 만들어 사용하세요. (git에 올리지 않기)
# - 운영: `.env.production` 또는 서버 환경변수로 주입하세요. (git에 올리지 않기)
#
# 보안 규칙:
# - 서버 전용 시크릿은 NEXT_PUBLIC_ 접두어를 붙이면 절대 안 됩니다.
# =========================================================

# ---------- 필수(프론트/서버 공통) ----------
# 백엔드 API 서버 (Next rewrites 및 일부 client direct call에서 사용)
NEXT_PUBLIC_API_SERVER_URI=https://cloud.aiaracorp.com:8800

# 유저웹 도메인(본인인증 returnurl, 결제 redirectUrl 등)
# 로컬 개발 시:
NEXT_PUBLIC_WWW_SERVER_URI=http://localhost:3000

# 서버 컴포넌트에서 직접 호출하는 API 서버(서버 전용)
# 예: find-id/find-password NICE 콜백에서 사용
API_SERVER_URI=https://cloud.aiaracorp.com:8800

# ---------- 필수(서버 전용 / 절대 노출 금지) ----------
# iron-session 암호화 키 (최소 32자)
IRON_SESSION_PASSWORD=PLEASE_SET_A_RANDOM_STRING_AT_LEAST_32_CHARS_LONG

# (선택) iron-session 쿠키명
IRON_SESSION_COOKIE_NAME=iron-session-likenovel-user

# NICE 본인인증 (서버 전용)
NICE_CLIENT_ID=PLEASE_SET
NICE_CLIENT_SECRET=PLEASE_SET
NICE_PRODUCT_ID=2101979031

# ---------- 소셜 로그인(필요 시) ----------
NEXT_PUBLIC_NAVER_CLIENT_ID=
NEXT_PUBLIC_KAKAO_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_CLIENT_ID=

NEXT_PUBLIC_NAVER_SIGNIN_REDIRECT_URI=
NEXT_PUBLIC_KAKAO_SIGNIN_REDIRECT_URI=
NEXT_PUBLIC_GOOGLE_SIGNIN_REDIRECT_URI=
NEXT_PUBLIC_APPLE_SIGNIN_REDIRECT_URI=

NEXT_PUBLIC_NAVER_SIGNUP_REDIRECT_URI=
NEXT_PUBLIC_KAKAO_SIGNUP_REDIRECT_URI=
NEXT_PUBLIC_GOOGLE_SIGNUP_REDIRECT_URI=
NEXT_PUBLIC_APPLE_SIGNUP_REDIRECT_URI=

# ---------- 결제(PortOne) ----------
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=

# ---------- 기타 ----------
NEXT_PUBLIC_PARTNER_SITE_URL=


