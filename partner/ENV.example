# likenovel-partner (Next.js) - 환경변수 예시 (DO NOT COMMIT .env/.env.production)
#
# - 로컬 개발: `.env`
# - 스테이징/운영(Next start): `.env.production`
#
# NOTE:
# - NEXT_PUBLIC_* 는 프론트 번들에 포함될 수 있으므로, 민감정보를 넣지 마세요.

# API (Next rewrites)
NEXT_PUBLIC_API_URL=https://api.likenovel.net

# 사이트 간 링크/연동
NEXT_PUBLIC_USER_SITE_URL=https://likenovel.net
NEXT_PUBLIC_CMS_SITE_URL=https://cms.likenovel.net

# 파트너 내부 라우팅/호스트(코드에서 http:// 로 사용되는 경우가 있어 값 주의)
NEXT_PUBLIC_HOST_PARTNER_URL=partner.likenovel.net

# CDN 호스트 (도메인만 넣는 형태로 사용됨)
NEXT_PUBLIC_HOST_CDN_URL=cdn.likenovel.net

# (서버 전용) 검색/인덱스(Meilisearch)
MEILISEARCH_HOST=https://search.likenovel.net
MEILISEARCH_API_KEY=PLEASE_SET

